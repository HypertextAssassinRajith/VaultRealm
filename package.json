{
  "name": "vaultrealm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vaultrealm/api --filter @vaultrealm/web --parallel run dev",
    "dev:all": "pnpm -r --parallel run dev",
    "dev:bot": "pnpm --filter @vaultrealm/bot-runner run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @vaultrealm/api run db:generate",
    "db:migrate": "pnpm --filter @vaultrealm/api run db:migrate",
    "docker:build": "docker build -t vaultrealm:latest .",
    "docker:build:bot": "docker build -f apps/bot-runner/Dockerfile -t vaultrealm/bot-runner:latest ."
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
