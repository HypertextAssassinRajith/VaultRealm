# VaultRealm AI Companion Bot Runner Configuration
# These are automatically passed when spawned via the VaultRealm Panel Docker driver.
# For standalone local testing, copy to .env and customize:

BOT_ID=dev-bot-1
BOT_NAME=Buddy
BOT_TOKEN=vr_bot_dev_token_example
SERVER_ID=default-server
SERVER_HOST=localhost
SERVER_PORT=25565
AUTH_MODE=offline
PERSONA=helpful friend
PANEL_GATEWAY_URL=http://localhost:3001
MINECRAFT_VERSION=1.21.1
OWNER_NAME=admin
WHO_CAN_COMMAND=everyone
USE_JSON_FALLBACK=false
