# VaultRealm API environment variables
# Copy to .env and fill in values

PANEL_SECRET=change-me-to-a-random-string-at-least-16-chars
DATA_DIR=./data
PORT=3001
PORT_RANGE=25000-29999
HOST_RAM_BUDGET_PCT=85
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ALLOW_PRIVATE_LLM_ENDPOINTS=false
