# VaultRealm Root Environment Template
# Copy this file to apps/api/.env or create root .env

# --- Panel Backend (apps/api/.env) ---
PANEL_SECRET=change-me-to-a-random-string-at-least-16-chars
DATA_DIR=./data
PORT=3001
PORT_RANGE=25000-29999
HOST_RAM_BUDGET_PCT=85
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ALLOW_PRIVATE_LLM_ENDPOINTS=false

# --- AI Companion Bot Runner (apps/bot-runner/.env) ---
# Automatically injected when spawned from panel containers.
# BOT_ID=dev-bot-1
# BOT_TOKEN=vr_bot_dev_token
# SERVER_HOST=localhost
# SERVER_PORT=25565
# PANEL_GATEWAY_URL=http://localhost:3001
