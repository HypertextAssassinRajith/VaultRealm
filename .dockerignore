# Dependencies (reinstalled in container)
node_modules
**/node_modules

# Build artifacts (rebuilt in container)
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Runtime data
data
**/data

# Git
.git
.gitignore

# Environment files
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*

# IDE
.vscode
.idea
*.sw?
*.swo

# OS
.DS_Store
Thumbs.db

# Docs & CI (not needed in image)
docs/
*.md
!README.md
.prettierrc
.agents/

# Docker (avoid recursive context)
Dockerfile
docker-compose.yml
Caddyfile
.dockerignore

# Logs
*.log
logs/
**/logs

# Test files
apps/api/test/
apps/api/vitest.config.*
apps/bot-runner/test/
apps/bot-runner/vitest.config.*
